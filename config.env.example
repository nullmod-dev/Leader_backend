# ---------------------------------------------------------------------------
# Leader backend — environment. Copy to `config.env` and adjust.
# Nothing in this file is a real secret; production values come from your
# deployment's secret store.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Absolute origin used to build public file URLs (images under /images/...).
# On the Android emulator the host machine is http://10.0.2.2:4000.
PUBLIC_BASE_URL=http://localhost:4000

# Local MongoDB (started by `npm run db`, a single-node replica set so
# multi-document transactions work).
MONGODB_URI=mongodb://127.0.0.1:27017/leader?replicaSet=rs0&directConnection=true

# Tokens. Access tokens are short JWTs; refresh tokens are opaque, rotating,
# single-use and stored hashed. REFRESH_TOKEN_TTL_DAYS is the IDLE limit: each
# refresh and GET /auth/me slides the session to now + that many days (7 matches
# the app's offline window: 7 days from its last server contact).
# SESSION_MAX_DAYS is the ABSOLUTE limit from sign-in, however active the
# session is. After either, the account signs in again.
# JWT_SECRET is required (min 32 chars) unless NODE_ENV is development/test.
# Generate one with: openssl rand -hex 48
JWT_SECRET=change-me-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
ONBOARDING_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_DAYS=30
RESET_TOKEN_TTL_MINUTES=15

# Device trust. A sign-in from a device the account does not trust needs an
# emailed code; on an account that already has a device, that new device's
# sessions are restricted for NEW_DEVICE_RESTRICT_HOURS unless a trusted device
# answers "Yes". At most TRUSTED_DEVICES_MAX trusted devices per account.
TRUSTED_DEVICES_MAX=3
NEW_DEVICE_RESTRICT_HOURS=6

# CORS — browser origins allowed to call the API: a comma list, or * for any
# origin. The mobile app sends no Origin and is unaffected. Leave it EMPTY in
# production unless a web dashboard needs it (then name that origin only);
# unset, it is * in development/test and closed everywhere else.
CORS_ORIGINS=

# Google sign-in: the OAuth *Web* client id the app passes as
# MTM_GOOGLE_SERVER_CLIENT_ID. Empty = Google answers `unsupported_auth_method`.
GOOGLE_CLIENT_ID=
# Development only: accept `mock-google:<email>` / `mock-google-unverified:<email>`
# id tokens (the same convention as the Flutter mock). Always off in production.
ALLOW_MOCK_GOOGLE=true

# Development only: pin every emailed OTP to this value (matches the Flutter
# mock's 246810). Leave empty to generate random codes. Ignored in production.
DEV_FIXED_OTP=246810
# Development only: expose GET /api/v1/dev/mailbox to read sent emails.
DEV_MAILBOX=true

# SMTP (optional). Without it, emails are written to the dev mailbox + log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Leader <no-reply@leader.local>"

# Seed accounts' password (npm run seed).
SEED_PASSWORD=Leader@12345

# Uploads
MAX_UPLOAD_MB=5

# Background jobs (expiry of demos, break-glass grants, invitations).
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# Rate limiting (express-rate-limit). Always off when NODE_ENV=test.
RATE_LIMIT_ENABLED=true

# Data-layer tenant-scope guard (models/plugins/tenantScope.js):
# off (code default) | log (report violations only) | enforce (refuse them).
# Rollout: run production on `log`, watch the reports (and the
# tenant_scope_violation security signals) for a week, mark or fix each call
# site, then switch to `enforce`. See docs/DEPLOYMENT.md.
TENANT_SCOPE_MODE=log
# Optional file path: guard reports are appended here (JSON lines) instead of stderr.
TENANT_SCOPE_LOG=

# Port used by `npm run db` (scripts/local-mongo.js). Keep MONGODB_URI in step.
LOCAL_MONGO_PORT=27017
