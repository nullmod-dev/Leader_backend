[Unit]
Description=Leader API (Node.js) — /opt/leader/backend
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=leader
Group=leader
WorkingDirectory=/opt/leader/backend
ExecStart=/usr/bin/node /opt/leader/backend/server.js
Restart=on-failure
RestartSec=5
# config.env (mode 600, owner leader) is read by server.js itself.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leader/backend/public/images
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
